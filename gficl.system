(in-package "CL-USER")
(defvar *gficl-source-dir* "/7/gtk/EXT-LISP/gficl/")
(defvar *gficl-binary-dir* (binary-directory *gficl-source-dir*))

(mk:defsystem :gficl-examples
  :source-pathname *gficl-source-dir*
  :binary-pathname *gficl-binary-dir*
  :source-extension "lisp"
  :depends-on (:gficl
	       :gficl/load)
  :components ((:module "examples"
		:components ((:file "package")
			     (:file "minimum")
			     (:file "minimum-app")
			     (:file "quad-spin")
			     (:file "cube-wave")
			     (:file "post-processing")
			     (:file "model-loading")
			     (:file "font-rendering")
			     (:file "shadows")
			     (:file "pbr")))))

#+nil
(mk:oos :gficl-examples :load :compile-during-load t)

(mk:defsystem :gficl-examples-shadertoy
  :source-pathname *gficl-source-dir*
  :binary-pathname *gficl-binary-dir*
  :source-extension "lisp"
  :depends-on (:gficl)
  :components ((:module "examples"
		:components ((:file "gficl-shadertoy")))))

#+nil
(mk:oos :gficl-examples-shadertoy :load :compile-during-load t)

(mk:defsystem :gficl/load
  :source-pathname *gficl-source-dir*
  :binary-pathname *gficl-binary-dir*
  :source-extension "lisp"
  :depends-on (:gficl
	       :cl-wavefront
	       :cl-gltf
	       :pngload
	       :cl-jpeg
	       :truetype-clx)
  :components ((:module "src/load"
		:components ((:file "package")
			     (:file "model")
			     (:file "shader")
			     (:file "image")
			     (:file "font")))))

#+nil
(mk:oos :gficl/load :load :compile-during-load t)

(mk:defsystem :gficl
  :source-pathname *gficl-source-dir*
  :binary-pathname *gficl-binary-dir*
  :source-extension "lisp"
  :depends-on (:uiop
	       :cl-glfw3
	       :cl-opengl
	       :cffi)
  :components ((:module "src"
		:components ((:file "package")
			     (:file "base-app"
			      :depends-on ("gficl" "types"))
			     (:file "gficl"
			      :depends-on ("input"))
			     (:file "input"
			      :depends-on ("state"))
			     (:file "state")
			     (:file "types")
			     (:file "vector")
			     (:file "quaternion"
			      :depends-on ("vector"))
			     (:file "matrix"
			      :depends-on ("quaternion"
					   "shader"))
			     (:file "shader"
			      :depends-on ("types"))
			     (:file "framebuffer"
			      :depends-on ("types"
					   "image"))
			     (:file "image"
			      :depends-on ("types"))
			     (:file "vertex"
			      :depends-on ("types"))
			     (:file "buffer"
			      :depends-on ("types"))))))

#+nil
(mk:oos :gficl :load :compile-during-load t)

(mk:defsystem :gficl-bt
  :source-pathname *gficl-source-dir*
  :binary-pathname *gficl-binary-dir*
  :source-extension "lisp"
  :depends-on (:gficl :bordeaux-threads)
  :components ((:module "src"
		:components ((:file "base-app-bt")))))

#+nil
(mk:oos :gficl-bt :load :compile-during-load t)

(mk:defsystem :gficl-examples-bt
  :source-pathname *gficl-source-dir*
  :binary-pathname *gficl-binary-dir*
  :source-extension "lisp"
  :depends-on (:gficl-bt)
  :components ((:module "examples"
		:components ((:file "minimum-app")
			     (:file "minimum-app-bt")))))

#+nil
(mk:oos :gficl-examples-bt :load :compile-during-load t)


;;; ----------------------------------------------------------------------
;;;
;;; extra loaders
;;;

(mk:defsystem :gficl/load/imlib2
  :source-pathname *gficl-source-dir*
  :binary-pathname *gficl-binary-dir*
  :source-extension "lisp"
  :depends-on ( #+nil :gficl/load
		:gficl
		(:feature :claw-imlib
		 "claw-cxx-imlib2.bindings"))
  :components ((:module "src/load"
		:components (;; #+nil
			     (:file "imlib2-min-x86_64-pc-linux-gnu"
			      :if-feature (:not :claw-imlib))
			     (:file "image-imlib2")))))

#+nil
(mk:oos :gficl/load/imlib2 :load :compile-during-load t)
